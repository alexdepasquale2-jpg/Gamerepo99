+/** Fixed path: prefer non-axis alone (old lines.json verbatim), then mirrors. */
+function pickPreferredAlone(
+  alone: Array<{ id: string; text: string; tags?: string[] }>,
+): { id: string; text: string; tags?: string[] } | undefined {
+  const noAxis = alone.filter((f) => !(f.tags ?? []).some((t) => t.startsWith('axis:')));
