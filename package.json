{
  "name": "the-last-spark",
  "version": "0.1.0",
  "private": true,
  "description": "The Last Spark — walk into towns and reignite people, one spark at a time",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bots": "vitest run tests/bots",
    "test:e2e": "vite build && playwright test",
    "test:e2e:smoke": "vite build && playwright test tests/e2e/m3-overworld-smoke.spec.ts",
    "check": "npm run validate && tsc --noEmit && vitest run",
    "check:all": "npm run check && npm run test:e2e",
    "qa:shots": "E2E_UPDATE_SHOTS=1 npm run test:e2e",
    "validate": "node scripts/validate-data.mjs",
    "evidence:m5": "vite-node scripts/m5-depth-evidence.mts",
    "bake:social": "vite-node scripts/bake-social-web.ts",
    "perf:dawn": "vite-node scripts/perf-dawn.mts",
    "balance": "vite-node scripts/balance-bots.mts",
    "map:ascii": "vite-node scripts/map-ascii.mts",
    "build:playtest": "VITE_PLAYTEST=1 vite build --base=./"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
