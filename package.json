{
  "name": "the-last-spark",
  "version": "0.1.0",
  "private": true,
  "description": "The Last Spark — walk into towns and reignite people, one spark at a time",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-data": "node scripts/validate-data.mjs",
    "test:e2e": "playwright test",
    "test:e2e:m1": "playwright test tests/e2e/m1-smoke.spec.ts",
    "test:e2e:m3": "playwright test tests/e2e/m3-overworld-smoke.spec.ts",
    "verify:m1": "npm test && npm run build && npm run test:e2e:m1",
    "validate": "node scripts/validate-data.mjs",
    "bake:social": "vite-node scripts/bake-social-web.ts",
    "perf:dawn": "vite-node scripts/perf-dawn.mts",
    "test:bots": "vitest run tests/bots",
    "balance": "vite-node scripts/balance-bots.mts"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
