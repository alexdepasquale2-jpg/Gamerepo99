    },
    {
      "id": "introduce",
      "label": "Introduce to someone you met",
      "short": "Introduce",
      "hostMethod": "inspire",
      "requiresOtherPerson": true,
      "family": "speak"
    },
    {
      "id": "favor_ask",
      "label": "Ask a favor",
      "short": "Ask a favor",
      "hostMethod": "inspire",
      "oncePerDay": true,
      "minTrust": 0.25,
      "lend": {
        "itemTagsAny": [
          "work",
          "craft",
          "build",
          "warmth",
          "trade"
        ]
      },
      "lines": [
        "{name} brightens. \"Me? Of course I can.\"",
        "{name} straightens up. \"Glad someone asked.\"",
        "{name} nods slowly. \"It's good to be needed.\""
      ],
      "family": "ask"
    },
    {
      "id": "show_up",
      "label": "Show up",
      "short": "Show up",
      "hostMethod": "inspire",
      "oncePerDay": true,
      "lines": [
        "{name} notices you came. Neither of you says much.",
        "{name} makes room for you without a word.",
        "{name} glances over. \"You're here again.\""
      ],
      "family": "help"
    },
    {
      "id": "talk_empty_cheer",
      "label": "Cheer up (empty words)",
      "short": "Cheer them up",
      "hostMethod": "lie",
      "oncePerDay": true,
      "lines": [
        "{name} smiles, but it doesn't reach the eyes.",
        "{name} says \"Sure,\" and looks away.",
        "{name} nods along. Nothing changes."
      ],
      "failLine": "{name} hears how hollow it is and turns away.",
      "family": "speak"
    },
    {
      "id": "return_item",
      "label": "Return what's theirs",
      "short": "Return theirs",
      "hostMethod": "carry_burden",
      "requiresTheirGoods": true,
      "family": "give"
    }
  ],
  "familiesNote": "Ring families in order. speak..deal hold people's verbs (history: ask; stash and patrons: deal through aliases; the held item's person verbs: give). use = the held item's verbs on a thing; work = a thing's own verbs (gather, tend, land acts, animals). Every verb has label (full) and short (chip, <=16)."
}
