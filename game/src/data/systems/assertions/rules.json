{
  "rules": [
    {
      "id": "rule_no_cheerful_grief",
      "forbid": {
        "wound": "grief",
        "moodTagsAny": [
          "mood:cheerful",
          "mood:chipper"
        ]
      }
    },
    {
      "id": "rule_no_doctrine_rise_after_expose",
      "forbid": {
        "afterEvent": "doctrine.exposed",
        "statRise": "doctrine.followerCount"
      }
    },
    {
      "id": "rule_no_dead_speak",
      "forbid": {
        "personFlagsAny": [
          "dead"
        ],
        "action": "speak_or_meet"
      }
    },
    {
      "id": "rule_no_contradict_memory",
      "forbid": {
        "lineTagsAny": [
          "mood:naive_hope",
          "mood:chipper"
        ],
        "memoryIncludesAny": [
          "mark:hollowness",
          "mark:dependence"
        ]
      }
    },
    {
      "id": "rule_voice_vector_bounds",
      "forbid": {
        "vectorOutOfBounds": true
      }
    },
    {
      "id": "rule_no_shamed_child_calls_kind",
      "forbid": {
        "personTagsAny": [
          "child"
        ],
        "afterEvent": "shame_resolved",
        "lineTagsAny": [
          "mood:calls_protagonist_kind"
        ]
      }
    },
    {
      "id": "rule_no_trust_after_betrayal",
      "forbid": {
        "afterEvent": "betrayal",
        "withinDays": 1,
        "trustAbove": 0.7
      }
    },
    {
      "id": "rule_history_order",
      "forbid": {
        "historyOutOfOrder": true
      }
    }
  ]
}
