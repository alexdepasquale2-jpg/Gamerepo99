{
  "version": 1,
  "spec": "What the wild props drawn in each chunk (sim/map/ladder/dress.ts, stamp-raster road props) do when you stand by them. One row per prop type: name (the prompt label) and verbs (same shape as node/fauna verbs: id, label, short <= 16, needs?, effect bundle; see contrib/use-effects). Every prop verb is once per day per prop type, so a forest of trees is not a wood pile. Critters are not here: they use their animal's verbs in fauna.json. See contrib/thing-verbs.ts. Only verbs that make or change something are verbs: resting is not a menu choice. linger (optional): shade, seat, fire, shelter or holy; standing still by such a prop sits you down (world/linger.ts) and spark trickles in under the shared daily prop cap (sim/linger.ts). lingerTags: per tag, secsPerSpark (seconds sat for one spark) and pose (sit: lowered; stand: upright and still), where (how a neighbour says they saw you, at dawn). scenery: true for a prop with no use at all.",
  "lingerTags": {
    "shade": { "secsPerSpark": 30, "pose": "sit", "where": "resting in the shade" },
    "seat": { "secsPerSpark": 30, "pose": "sit", "where": "sitting out by the road" },
    "fire": { "secsPerSpark": 20, "pose": "sit", "where": "warming yourself at a fire" },
    "shelter": { "secsPerSpark": 25, "pose": "sit", "where": "resting under canvas" },
    "holy": { "secsPerSpark": 15, "pose": "stand", "where": "standing quiet at the shrine" }
  },
  "props": [
    { "type": "tree", "name": "Tree", "linger": "shade", "verbs": [
      { "id": "branches", "label": "Gather fallen branches", "short": "Gather branches", "effect": { "gain": { "wood": 1 }, "done": "You snap up a few dry branches from under the tree." } }
    ] },
    { "type": "bush", "name": "Bush", "verbs": [
      { "id": "search", "label": "Search it for berries", "short": "Find berries", "effect": { "gain": { "berries": 1 }, "done": "A handful of berries, half hidden under the leaves." } },
      { "id": "clear", "label": "Pull the bindweed off it", "short": "Pull bindweed", "effect": { "regrow": ["berry_bush", "herb_patch"], "done": "You tear the weed away. The patches round here will come back quicker." } }
    ] },
    { "type": "rock", "name": "Rock", "linger": "seat", "verbs": [
      { "id": "stone", "label": "Pick up a loose stone", "short": "Take a stone", "effect": { "gain": { "stone": 1 }, "done": "A good flat stone comes away in your hand." } }
    ] },
    { "type": "boulder", "name": "Boulder", "linger": "seat", "verbs": [
      { "id": "chip", "label": "Chip a stone off it", "short": "Chip a stone", "effect": { "gain": { "stone": 1 }, "done": "It takes a while, but a stone splits free." } }
    ] },
    { "type": "log", "name": "Fallen log", "linger": "seat", "verbs": [
      { "id": "kindling", "label": "Split off some kindling", "short": "Split kindling", "effect": { "gain": { "wood": 1 }, "done": "The rotten end breaks into good dry kindling." } }
    ] },
    { "type": "stump", "name": "Stump", "linger": "seat", "verbs": [
      { "id": "roots", "label": "Dig out the dry roots", "short": "Dig out roots", "effect": { "gain": { "wood": 1 }, "done": "The old roots come up dry enough to burn." } }
    ] },
    { "type": "sign", "name": "Sign", "scenery": true, "verbs": [] },
    { "type": "hay", "name": "Haystack", "linger": "seat", "verbs": [
      { "id": "grain", "label": "Shake out the loose grain", "short": "Shake out grain", "effect": { "gain": { "grain": 1 }, "done": "A little grain the threshers missed falls into your hand." } }
    ] },
    { "type": "flowers", "name": "Wildflowers", "verbs": [
      { "id": "herbs", "label": "Pick the herbs among them", "short": "Pick herbs", "effect": { "gain": { "herbs": 1 }, "done": "Between the flowers grow a few herbs worth having." } }
    ] },
    { "type": "reeds", "name": "Reeds", "verbs": [
      { "id": "cut", "label": "Cut reeds for fibre", "short": "Cut reeds", "effect": { "gain": { "flax": 1 }, "done": "The reeds split into long fibres, good for twine." } }
    ] },
    { "type": "fence_h", "name": "Fence", "verbs": [
      { "id": "mend", "label": "Mend a loose rail", "short": "Mend a rail", "needs": { "wood": 1 }, "effect": { "spark": 3, "done": "You lash the rail back in place. The sheep stay in another night." } }
    ] },
    { "type": "fence_v", "name": "Fence", "verbs": [
      { "id": "mend", "label": "Mend a loose rail", "short": "Mend a rail", "needs": { "wood": 1 }, "effect": { "spark": 3, "done": "You lash the rail back in place. The sheep stay in another night." } }
    ] },
    { "type": "field", "name": "Field", "verbs": [
      { "id": "glean", "label": "Glean the field edge", "short": "Glean the edge", "effect": { "gain": { "grain": 1 }, "done": "You glean what the harvest left behind." } }
    ] },
    { "type": "farmstead", "name": "Farmstead", "scenery": true, "verbs": [] },
    { "type": "build_site", "name": "Build site", "verbs": [
      { "id": "timber", "label": "Leave timber for the builders", "short": "Leave timber", "needs": { "timber": 1 }, "effect": { "spark": 4, "despair": -0.01, "done": "You stack the timber by the frame. Someone will be glad of it." } }
    ] },
    { "type": "campfire", "name": "Campfire", "linger": "fire", "verbs": [
      { "id": "roast", "label": "Roast a fish on the embers", "short": "Roast a fish", "needs": { "fish": 1 }, "effect": { "spark": 10, "done": "The fish crisps on a stick. Best meal in days." } }
    ] },
    { "type": "tent", "name": "Tent", "linger": "shelter", "verbs": [
      { "id": "look", "label": "Look inside the tent", "short": "Look inside", "effect": { "gain": { "rope": 1 }, "done": "Empty, but someone left a coil of rope behind." } }
    ] },
    { "type": "ruin_wall", "name": "Ruined wall", "verbs": [
      { "id": "rubble", "label": "Search the rubble", "short": "Search rubble", "effect": { "gain": { "stone": 1 }, "done": "You pull a squared stone from the rubble." } }
    ] },
    { "type": "shrine", "name": "Shrine", "linger": "holy", "verbs": [
      { "id": "offer", "label": "Leave bread as an offering", "short": "Leave offering", "needs": { "bread": 1 }, "effect": { "spark": 6, "despair": -0.02, "done": "You leave the bread on the stone. Word of it will get back to town." } }
    ] },
    { "type": "cart", "name": "Old cart", "linger": "seat", "verbs": [
      { "id": "search", "label": "Search the old cart", "short": "Search the cart", "effect": { "gain": { "wood": 1 }, "done": "A broken board, but it will burn." } }
    ] },
    { "type": "mine", "name": "Old mine", "verbs": [
      { "id": "spoil", "label": "Pick through the spoil heap", "short": "Sift the spoil", "effect": { "gain": { "ore": 1 }, "done": "Among the waste rock is a lump with iron in it." } }
    ] },
    { "type": "camp", "name": "Camp", "linger": "fire", "verbs": [
      { "id": "firewood", "label": "Help gather firewood", "short": "Gather firewood", "effect": { "gain": { "wood": 1 }, "done": "You bring in an armful. They let you keep a share." } }
    ] },
    { "type": "waystation", "name": "Wayside shelter", "linger": "seat", "verbs": [] }
  ]
}
