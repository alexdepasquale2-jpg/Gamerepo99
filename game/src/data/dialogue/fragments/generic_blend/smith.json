      "weight": 0.8,
      "slot": "middle"
    },
    {
      "id": "frag_gen_smith_carry_burden_middle_spark_low",
      "text": "Hand it here. Arms are slower than they were.",
      "tags": [
        "generic:gen_smith",
        "method:carry_burden",
        "dict:forge",
        "shape:blunt",
        "slot:middle",
        "axis:spark_low",
