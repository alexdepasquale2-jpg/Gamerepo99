{
  "version": 1,
  "spec": "docs/superpowers/specs/2026-11-06-interaction-model.md",
  "spark": {
    "source": "player.defaults",
    "sparkMax": 100,
    "sparkStart": 88,
    "burnoutAt": 0,
    "formula": "clamp(spark - baseStrain * situationMul + sparkGain, 0, sparkMax)",
    "situationMulDefault": 1,
    "dawnRecoveryRef": "time.recovery_base_dawn",
    "strainMulByTag": {
      "hard": 0.44,
      "shame_lean": 0.44
    },
    "sparkGainAdjustByTag": {
      "gentle": -1,
      "presence": -1
    },
    "balanceNote": "Harsh strain softened (~6 -> ~11 dawns to burnout for brood/marrow); gentle talk/presence net -1 spark so kindness is not free. Tag-driven, never archetype branches."
  },
  "touchScoreWeights": {
    "flame01Abs": 10,
    "genuine_growth": 4,
    "keptPromise": 5,
    "presenceDay": 1,
    "giftAccepted": 3,
    "stoodUp": 4,
    "brokenPromise": -6,
    "hollownessAdd": -3,
    "resentmentAdd": -2,
    "bond": 5,
    "meaning": 4
  },
  "reignite": {
    "touchScoreMin": 24,
    "flame01Min": 0.45,
    "requireHollownessStacks": 0,
    "alternate": {
      "requireMark": "genuine_growth",
      "touchScoreMin": 18,
      "flame01Min": 0.45
    },
    "onReignite": {
      "marksRemove": [
        "hollowness"
      ],
      "marksAdd": [
        {
          "markId": "genuine_growth",
          "stacks": 1
        }
      ],
      "juice": "person.reignite"
    },
    "neverFromSingleInteraction": true,
    "minDistinctKinds": 3
  },
  "hollowDeepen": {
    "when": "touchScoreStall_and_brokenPromise_or_shameWithoutRepair"
  }
}
