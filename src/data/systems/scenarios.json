{
  "version": 1,
  "spec": "tests/scenarios/README.md",
  "api": "createPlaySession",
  "actionIdFormat": "methodId@personId | advance:dusk | advance:dawn | advance:day | advance:ticks:N | approach@personId",
  "snapshotExtensions": [
    "people.<id>.flame",
    "people.<id>.marks",
    "people.<id>.siteKindled",
    "player.spark",
    "bus.ids",
    "lines.lastReactionId",
    "lines.lastRefusalId",
    "packets.inbox",
    "metrics.firstChoiceAtTick",
    "metrics.firstConsequenceAtTick",
    "menu.methodIds"
  ],
  "scenarios": [
    {
      "id": "moment_warm_loaf_cold_hill",
      "kind": "memorable_moment",
      "title": "Warm loaf, cold hill",
      "seed": 7,
      "archetypeId": "marrow",
      "setup": {
        "townId": "ashford",
        "ensure": [
          {
            "personId": "marta_ellison",
            "flame": 20,
            "marks": []
          },
          {
            "personId": "jonah_pike",
            "burning": false
          }
        ]
      },
      "steps": [
        {
          "op": "approach",
          "personId": "marta_ellison"
        },
        {
          "op": "method",
          "methodId": "carry_burden",
          "targetPersonId": "marta_ellison"
        },
        {
          "op": "advance",
          "to": "dusk"
        }
      ],
      "expect": {
        "busContainsAny": [
          "site.kindle",
          "spark.spend"
        ],
        "people": {
          "marta_ellison": {
            "siteKindled": true,
            "flameMin": 50
          }
        },
        "player": {
          "sparkDecreasedSinceStart": true
        },
        "hooksFiredAny": [
          "cost_loneliness_tax"
        ]
      },
      "features": {
        "bakedDynamismLines": false
      }
    },
    {
      "id": "moment_chalk_after_the_cut",
      "kind": "memorable_moment",
      "title": "Chalk after the cut",
      "seed": 13,
      "archetypeId": "ivy_quill",
      "setup": {
        "townId": "ashford",
        "ensure": [
          {
            "personId": "ruth_calder",
            "flame": 35,
            "marks": []
          },
          {
            "personId": "jonah_pike",
            "burning": true,
            "flame": 55
          }
        ]
      },
      "steps": [
        {
          "op": "approach",
          "personId": "ruth_calder"
        },
        {
          "op": "method",
          "methodId": "shame",
          "targetPersonId": "ruth_calder"
        },
        {
          "op": "record",
          "as": "flameAfterResolve",
          "path": "people.ruth_calder.flame"
        },
        {
          "op": "advance",
          "to": "dawn"
        },
        {
          "op": "advance",
          "to": "dawn"
        }
      ],
      "expect": {
        "people": {
          "ruth_calder": {
            "hasMark": "hollowness",
            "flameLessThanRecord": "flameAfterResolve"
          }
        },
        "busContainsAnyOptional": [
          "ripple.harm"
        ]
      },
      "features": {
        "bakedDynamismLines": false
      }
    },
    {
      "id": "moment_nail_across_the_water",
      "kind": "memorable_moment",
      "title": "Nail across the water",
      "seed": 21,
      "archetypeId": "marrow",
      "setup": {
        "townId": "ashford",
        "ensure": [
          {
            "personId": "elias_boone",
            "flame": 25,
            "marks": []
          }
        ]
      },
      "steps": [
        {
          "op": "approach",
          "personId": "elias_boone"
        },
        {
          "op": "method",
          "methodId": "challenge",
          "targetPersonId": "elias_boone"
        },
        {
          "op": "advance",
          "to": "dawn"
        }
      ],
      "expect": {
        "busContainsAny": [
          "packet.emit",
          "site.kindle"
        ],
        "people": {
          "elias_boone": {
            "hasMarkAny": [
              "genuine_growth",
              "fragile_hope"
            ]
          }
        },
        "packets": {
          "inboxNonEmptyForPersonAny": [
            "tom_briggs",
            "priya_sen"
          ]
        }
      },
      "features": {
        "bakedDynamismLines": false
      }
    },
    {
      "id": "moment_refusal_coal",
      "kind": "memorable_moment",
      "title": "Refusal coal",
      "seed": 3,
      "archetypeId": "marrow",
      "setup": {
        "townId": "ashford",
        "ensure": [
          {
            "personId": "jonah_pike",
            "tagsInclude": [
              "child"
            ]
          }
        ]
      },
      "steps": [
        {
          "op": "approach",
          "personId": "jonah_pike"
        },
        {
          "op": "method",
          "methodId": "shame",
          "targetPersonId": "jonah_pike"
        }
      ],
      "expect": {
        "refused": true,
        "busContainsAny": [
          "refusal.coal_flicker"
        ],
        "lines": {
          "lastRefusalHookId": "refusal_shame_child"
        },
        "menu": {
          "stillContainsMethodId": "shame"
        },
        "people": {
          "jonah_pike": {
            "marksUnchanged": true
          }
        }
      },
      "features": {
        "bakedDynamismLines": false
      }
    },
    {
      "id": "moment_mark_comes_back",
      "kind": "memorable_moment",
      "title": "Mark comes back",
      "seed": 17,
      "archetypeId": "marrow",
      "setup": {
        "townId": "ashford",
        "ensure": [
          {
            "personId": "harold_finch",
            "flame": 30,
            "marks": []
          }
        ]
      },
      "steps": [
        {
          "op": "approach",
          "personId": "harold_finch"
        },
        {
          "op": "method",
          "methodId": "challenge",
          "targetPersonId": "harold_finch"
        },
        {
          "op": "record",
          "as": "firstFlameDelta",
          "path": "lastResolve.flameDelta"
        },
        {
          "op": "record",
          "as": "firstSparkCost",
          "path": "lastResolve.sparkCost"
        },
        {
          "op": "method",
          "methodId": "carry_burden",
          "targetPersonId": "harold_finch"
        },
        {
          "op": "record",
          "as": "secondFlameDelta",
          "path": "lastResolve.flameDelta"
        },
        {
          "op": "record",
          "as": "secondSparkCost",
          "path": "lastResolve.sparkCost"
        }
      ],
      "expect": {
        "people": {
          "harold_finch": {
            "hasMarkAny": [
              "resentment",
              "dependence",
              "hollowness",
              "genuine_growth",
              "fragile_hope"
            ]
          }
        },
        "compare": {
          "assert": "secondResolveDiffersFromFirst",
          "paths": [
            "firstFlameDelta",
            "secondFlameDelta",
            "firstSparkCost",
            "secondSparkCost"
          ],
          "rule": "at_least_one_pair_differs"
        }
      },
      "features": {
        "bakedDynamismLines": false
      }
    },
    {
      "id": "first_10_minutes_ashford_hook",
      "kind": "first_10_minutes",
      "title": "Ashford first 10 minutes that hook",
      "seed": 11,
      "archetypeId": "marrow",
      "setup": {
        "townId": "ashford"
      },
      "steps": [
        {
          "op": "boot"
        },
        {
          "op": "note",
          "wallClockTargetSec": 45,
          "beat": "street_visible"
        },
        {
          "op": "approach",
          "personId": "marta_ellison"
        },
        {
          "op": "recordMetrics",
          "flag": "firstChoice"
        },
        {
          "op": "method",
          "methodId": "inspire",
          "targetPersonId": "marta_ellison"
        },
        {
          "op": "recordMetrics",
          "flag": "firstConsequence"
        },
        {
          "op": "approach",
          "personId": "jonah_pike"
        },
        {
          "op": "method",
          "methodId": "carry_burden",
          "targetPersonId": "jonah_pike"
        }
      ],
      "expect": {
        "metrics": {
          "firstChoiceAtTickMax": 24,
          "firstConsequenceAtTickMax": 48,
          "firstChoiceWallSecMax": 120,
          "firstConsequenceWallSecMax": 240
        },
        "busContainsAny": [
          "spark.spend",
          "person.reaction",
          "mark.applied",
          "site.kindle"
        ],
        "playerCanNameChange": {
          "anyOf": [
            "people.marta_ellison.siteKindled",
            "people.marta_ellison.hasMarkAny",
            "people.jonah_pike.flameChanged"
          ]
        }
      },
      "features": {
        "bakedDynamismLines": false
      }
    }
  ],
  "features": {
    "bakedDynamismLines": false
  },
  "notes": "All scenarios run with bakedDynamismLines=false so fixed lines.json paths hold. Brood M2: bodySlots=3, activeBodiesMax=1 (Forge 595d722) \u2014 scenarios must not require multi-active bodies. Line text asserts should prefer bus/marks/flame; if asserting text, allow lineIdAny including fallback mirrors.",
  "m2Brood": {
    "bodySlots": 3,
    "activeBodiesMax": 1,
    "doNotRequireMultiActive": true
  }
}
