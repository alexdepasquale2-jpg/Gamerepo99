{
  "version": 1,
  "spec": "docs/superpowers/specs/2026-11-05-doctrine-legitimacy-design.md",
  "formulas": {
    "legitimacy": "clamp(0.15 + 0.7*perceivedDelivery + 0.15*control, 0, 1)",
    "strainNote": "city promises use feltByMaxGapAxis so village realDelivery may stay 0",
    "collapse": "if gap>0.25 and exposure>0.4: legitimacy *= (1 - 2.5 * gap^2)"
  },
  "acts": [
    {
      "id": "act_expose_lie",
      "methodIds": [
        "challenge",
        "shame"
      ],
      "requiresTargetTagsAny": [
        "doctrine_voice",
        "leader"
      ],
      "effects": [
        {
          "target": "doctrine.exposure",
          "op": "add",
          "value": 0.25
        }
      ],
      "tags": [
        "doctrine",
        "expose"
      ]
    },
    {
      "id": "act_carry_promise",
      "methodIds": [
        "carry_burden",
        "inspire"
      ],
      "requiresPromiseId": true,
      "effects": [
        {
          "target": "doctrine.realDelivery",
          "op": "add",
          "value": 0.08
        },
        {
          "target": "doctrine.perceivedDelivery",
          "op": "add",
          "value": 0.03
        }
      ],
      "tags": [
        "doctrine",
        "keep"
      ]
    },
    {
      "id": "act_become_voice",
      "methodIds": [
        "inspire",
        "challenge"
      ],
      "requiresActorTagsAny": [
        "civic_voice"
      ],
      "effects": [
        {
          "target": "town.standing",
          "op": "add",
          "value": 0.05
        },
        {
          "target": "doctrine.propaganda",
          "op": "add",
          "value": -0.05
        }
      ],
      "tags": [
        "doctrine",
        "voice"
      ]
    }
  ],
  "doctrines": [
