      "fixture": {
        "person": {
          "tags": [
            "child"
          ]
        },
        "events": [
          "shame_resolved"
        ],
        "lineTags": [
          "mood:calls_protagonist_kind"
        ]
      }
    },
    {
      "id": "assert_shamed_child_wary_pass",
      "title": "Shamed child stays wary",
      "expectPass": true,
      "violatesRuleId": null,
      "fixture": {
        "person": {
          "tags": [
            "child"
          ]
        },
        "events": [
          "shame_resolved"
        ],
