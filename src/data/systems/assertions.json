    },
    {
      "id": "assert_history_ooo_fail",
      "title": "History beat out of order",
      "expectPass": false,
      "violatesRuleId": "rule_history_order",
      "fixture": {
        "historyApplied": [
          "hb_miracle_yeast"
        ],
        "historyTags": []
      }
