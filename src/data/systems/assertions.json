{
  "version": 1,
  "spec": "docs/superpowers/specs/2026-11-05-m2-dynamic-fabric-design.md",
  "axes": [
    "spark_low",
    "spark_high",
    "trust_low",
    "trust_high",
    "mark_grief",
    "mark_shame",
    "mark_dependence",
    "mark_hollowness",
    "mark_resentment",
    "doctrine_follower",
    "doctrine_skeptic",
    "notoriety_high",
    "kin_strain"
  ],
  "rules": [
    {
      "id": "rule_no_cheerful_grief",
      "forbid": {
        "wound": "grief",
        "moodTagsAny": [
          "mood:cheerful",
          "mood:chipper"
        ]
      }
    },
    {
      "id": "rule_no_doctrine_rise_after_expose",
      "forbid": {
        "afterEvent": "doctrine.exposed",
        "statRise": "doctrine.followerCount"
      }
    },
    {
      "id": "rule_no_dead_speak",
      "forbid": {
        "personFlagsAny": [
          "dead"
        ],
        "action": "speak_or_meet"
      }
    },
    {
      "id": "rule_no_contradict_memory",
      "forbid": {
        "lineTagsAny": [
          "mood:naive_hope"
        ],
        "memoryIncludes": "mark:hollowness"
      }
    },
    {
      "id": "rule_voice_vector_bounds",
      "forbid": {
        "vectorOutOfBounds": true
      }
    },
    {
      "id": "rule_no_shamed_child_calls_kind",
      "forbid": {
        "personTagsAny": [
          "child"
        ],
        "afterEvent": "shame_resolved",
        "lineTagsAny": [
          "mood:calls_protagonist_kind"
        ]
      }
    },
    {
      "id": "rule_no_trust_after_betrayal",
      "forbid": {
        "afterEvent": "betrayal",
        "withinDays": 1,
        "trustAbove": 0.7
      }
    },
    {
      "id": "rule_history_order",
      "forbid": {
        "historyOutOfOrder": true
      }
    }
  ],
  "cases": [
    {
      "id": "assert_grief_cheerful_fail",
      "title": "Grieving NPC speaking cheerfully",
      "expectPass": false,
      "violatesRuleId": "rule_no_cheerful_grief",
      "fixture": {
        "person": {
          "woundId": "grief",
          "alive": true
        },
        "lineTags": [
          "mood:cheerful"
        ],
        "action": "speak"
      }
    },
    {
      "id": "assert_grief_somber_pass",
      "title": "Grieving NPC speaking somberly",
      "expectPass": true,
      "violatesRuleId": null,
      "fixture": {
        "person": {
          "woundId": "grief",
          "alive": true
        },
        "lineTags": [
          "mood:somber",
          "shape:grief"
        ],
        "action": "speak"
      }
    },
    {
      "id": "assert_doctrine_rise_after_expose_fail",
      "title": "Follower count rises after expose",
      "expectPass": false,
      "violatesRuleId": "rule_no_doctrine_rise_after_expose",
      "fixture": {
        "events": [
          "doctrine.exposed"
        ],
        "stats": {
          "doctrine.followerCount": {
            "before": 10,
            "after": 14
          }
        }
      }
    },
    {
      "id": "assert_doctrine_fall_after_expose_pass",
      "title": "Follower count falls after expose",
      "expectPass": true,
      "violatesRuleId": null,
      "fixture": {
        "events": [
          "doctrine.exposed"
        ],
        "stats": {
          "doctrine.followerCount": {
            "before": 10,
            "after": 7
          }
        }
      }
    },
    {
      "id": "assert_dead_speak_fail",
      "title": "Dead person speaking",
      "expectPass": false,
      "violatesRuleId": "rule_no_dead_speak",
      "fixture": {
        "person": {
          "flags": [
            "dead"
          ],
          "alive": false
        },
        "action": "speak_or_meet"
      }
    },
    {
      "id": "assert_alive_speak_pass",
      "title": "Living person speaking",
      "expectPass": true,
      "violatesRuleId": null,
      "fixture": {
        "person": {
          "flags": [],
          "alive": true
        },
        "action": "speak_or_meet"
      }
    },
    {
      "id": "assert_memory_contradict_fail",
      "title": "Line contradicts hollowness memory",
      "expectPass": false,
      "violatesRuleId": "rule_no_contradict_memory",
      "fixture": {
        "memory": [
          "mark:hollowness"
        ],
        "lineTags": [
          "mood:naive_hope"
        ]
      }
    },
    {
      "id": "assert_memory_aligned_pass",
