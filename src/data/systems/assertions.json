    {
      "id": "assert_dependence_cheerful_fail",
      "title": "Dependent mark with chipper line",
      "expectPass": false,
      "violatesRuleId": "rule_no_contradict_memory",
      "fixture": {
        "memory": [
          "mark:dependence"
        ],
        "lineTags": [
          "mood:chipper"
        ]
      }
    },
    {
      "id": "assert_dependence_boundaried_pass",
      "title": "Dependent mark with boundary line",
      "expectPass": true,
      "violatesRuleId": null,
      "fixture": {
        "memory": [
          "mark:dependence"
        ],
        "lineTags": [
          "axis:mark_dependence",
          "mood:boundaried"
        ]
      }
    },
    {
      "id": "assert_vector_negative_fail",
      "title": "Negative vector component",
      "expectPass": false,
      "violatesRuleId": "rule_voice_vector_bounds",
      "fixture": {
        "vector": {
          "warmth": -0.1,
          "bite": 0.2,
          "piety": 0.2,
          "secrecy": 0.2,
          "weariness": 0.2
        }
      }
    },
    {
      "id": "assert_expose_then_recruit_fail",
      "title": "Recruit surge after expose same day",
      "expectPass": false,
      "violatesRuleId": "rule_no_doctrine_rise_after_expose",
      "fixture": {
        "events": [
          "doctrine.exposed"
        ],
        "stats": {
          "doctrine.followerCount": {
