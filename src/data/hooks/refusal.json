      "stillShowsInMenu": true,
      "consumesAct": false,
      "lines": {
        "default": [
          "The record stays. Even ugly truth stays."
        ],
        "ivy_quill": [
          "I will not burn a ledger to win a soul. Find another cut."
        ]
      },
      "lineVoiceFrom": "archetypeId",
      "effects": [],
      "tells": []
    }
  ]
