new file mode 100644
index 0000000..fdb3cb6
--- /dev/null
+++ b/tests/render/warmth-palette.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from 'vitest';
+import { FEEL } from '../../src/render/feel';
+import {
+  clampWarmth,
+  warmthFromUrl,
+  warmthToMatrixParams,
+  warmthToSatBrightness,
+  applyWarmthToColorMatrix,
+} from '../../src/render/warmth-palette';
+
+describe('warmth → palette ColorMatrix mapping', () => {
+  it('exposes FEEL.palette despair vs reignited tunables', () => {
+    expect(FEEL.palette.despair.saturation).toBeLessThan(0);
+    expect(FEEL.palette.despair.hueShift).toBeLessThan(0);
+    expect(FEEL.palette.reignited.saturation).toBeGreaterThan(FEEL.palette.despair.saturation);
+    expect(FEEL.palette.reignited.hueShift).toBeGreaterThan(FEEL.palette.despair.hueShift);
+  });
+
+  it('maps warmth 0 to despair params and 1 to reignited', () => {
+    const d = warmthToMatrixParams(0);
+    const r = warmthToMatrixParams(1);
+    expect(d.saturation).toBeCloseTo(FEEL.palette.despair.saturation);
+    expect(d.hueShift).toBeCloseTo(FEEL.palette.despair.hueShift);
+    expect(r.saturation).toBeCloseTo(FEEL.palette.reignited.saturation);
+    expect(r.brightness).toBeCloseTo(FEEL.palette.reignited.brightness);
+  });
+
+  it('lerps mid warmth between despair and reignited', () => {
+    const mid = warmthToMatrixParams(0.5);
+    const d = FEEL.palette.despair;
+    const r = FEEL.palette.reignited;
+    expect(mid.saturation).toBeCloseTo((d.saturation + r.saturation) / 2);
+    expect(mid.hueShift).toBeCloseTo((d.hueShift + r.hueShift) / 2);
+  });
+
+  it('despair is cooler/desaturated vs reignited (satBrightness helper)', () => {
+    const despair = warmthToSatBrightness(0);
+    const alive = warmthToSatBrightness(1);
+    expect(despair.sat).toBeLessThan(alive.sat);
+    expect(despair.hue).toBeLessThan(alive.hue);
+  });
+
+  it('clamps warmth and parses ?warmth= URL', () => {
+    expect(clampWarmth(-1)).toBe(0);
+    expect(clampWarmth(2)).toBe(1);
+    expect(warmthFromUrl('?warmth=0')).toBe(0);
+    expect(warmthFromUrl('?warmth=1')).toBe(1);
+    expect(warmthFromUrl('?warmth=0.5')).toBeCloseTo(0.5);
+    expect(warmthFromUrl('')).toBeNull();
+  });
+
+  it('applies params onto a ColorMatrix-like handle', () => {
+    const calls: string[] = [];
+    const fake = {
+      reset: () => calls.push('reset'),
+      saturate: (v: number) => calls.push(`sat:${v.toFixed(2)}`),
+      brightness: (v: number) => calls.push(`bri:${v.toFixed(2)}`),
+      contrast: (v: number) => calls.push(`con:${v.toFixed(2)}`),
+      hue: (v: number) => calls.push(`hue:${v.toFixed(1)}`),
+    };
+    applyWarmthToColorMatrix(fake, 0);
+    expect(calls[0]).toBe('reset');
+    expect(calls.some((c) => c.startsWith('sat:'))).toBe(true);
+    expect(calls.some((c) => c.startsWith('hue:'))).toBe(true);
+  });
+});
