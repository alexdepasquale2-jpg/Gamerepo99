diff --git a/src/render/warmth-palette.ts b/src/render/warmth-palette.ts
new file mode 100644
index 0000000..a343d35
--- /dev/null
+++ b/src/render/warmth-palette.ts
@@ -0,0 +1,92 @@
+/**
+ * Warmth (0 despair → 1 reignited) → ColorMatrix params.
+ * Presentation only; driven by FEEL.palette. Never an overlay rect.
+ */
+import type Phaser from 'phaser';
+import { FEEL } from './feel';
+
+export type WarmthMatrixParams = {
+  saturation: number;
+  brightness: number;
+  contrast: number;
+  hueShift: number;
+};
+
+function lerp(a: number, b: number, t: number): number {
+  return a + (b - a) * t;
+}
+
+/** Clamp warmth to [0,1]. */
+export function clampWarmth(w: number): number {
+  if (Number.isNaN(w)) return FEEL.overworld.defaultWarmth;
+  return Math.max(0, Math.min(1, w));
+}
+
+/** Lerp FEEL.palette despair→reignited by warmth. */
+export function warmthToMatrixParams(warmth: number): WarmthMatrixParams {
+  const t = clampWarmth(warmth);
+  const d = FEEL.palette.despair;
+  const r = FEEL.palette.reignited;
+  return {
+    saturation: lerp(d.saturation, r.saturation, t),
+    brightness: lerp(d.brightness, r.brightness, t),
+    contrast: lerp(d.contrast, r.contrast, t),
+    hueShift: lerp(d.hueShift, r.hueShift, t),
+  };
+}
+
+/**
+ * Approximate cool luminance bias for tests (despair pulls toward cooler gray).
+ * Not the shader itself — documents the intended despair/reignited mapping.
+ */
+export function warmthToSatBrightness(warmth: number): { sat: number; bright: number; hue: number } {
+  const p = warmthToMatrixParams(warmth);
+  return { sat: p.saturation, bright: p.brightness, hue: p.hueShift };
+}
+
+/** Read ?warmth=0|1 (or 0..1 float) from location search. */
+export function warmthFromUrl(search = typeof location !== 'undefined' ? location.search : ''): number | null {
+  const q = new URLSearchParams(search.startsWith('?') ? search.slice(1) : search);
+  if (!q.has('warmth')) return null;
+  const v = Number(q.get('warmth'));
+  if (Number.isNaN(v)) return null;
+  return clampWarmth(v);
+}
+
+export type ColorMatrixHandle = {
+  reset: () => unknown;
+  saturate: (v: number, multiply?: boolean) => unknown;
+  brightness: (v: number, multiply?: boolean) => unknown;
+  contrast: (v: number, multiply?: boolean) => unknown;
+  hue: (rotation: number, multiply?: boolean) => unknown;
+};
+
+/** Apply warmth params onto a Phaser ColorMatrix FX controller. */
+export function applyWarmthToColorMatrix(cm: ColorMatrixHandle, warmth: number): void {
+  const p = warmthToMatrixParams(warmth);
+  cm.reset();
+  // Order: saturate → brightness → contrast → hue (cool shift for despair)
+  cm.saturate(p.saturation, false);
+  cm.brightness(p.brightness, true);
+  cm.contrast(p.contrast, true);
+  cm.hue(p.hueShift, true);
+}
+
+/** Attach / refresh camera ColorMatrix postFX for the given warmth. */
+export function applyWarmthToCamera(
+  camera: Phaser.Cameras.Scene2D.Camera,
+  warmth: number,
+  existing?: Phaser.FX.ColorMatrix | null,
+): Phaser.FX.ColorMatrix | null {
+  try {
+    const cm =
+      existing ??
+      (camera.postFX?.addColorMatrix?.() as Phaser.FX.ColorMatrix | undefined) ??
+      null;
+    if (!cm) return null;
+    applyWarmthToColorMatrix(cm as unknown as ColorMatrixHandle, warmth);
+    return cm;
+  } catch {
+    return existing ?? null;
+  }
+}
